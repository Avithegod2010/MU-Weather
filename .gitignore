.tmp-uk-gen.cjs
.tmp-ru-gen.cjs
.tmp-build-catalog.cjs
.tmp-audit-langs.cjs
.tmp-dump-en.cjs
.tmp-en-dump.txt
.tmp-tsc.cjs
.tsc-code.txt
.tsc-out.txt
.tsc-ai-code.txt
.tsc-ai-out.txt
perfetto-captures/
*.pftrace
