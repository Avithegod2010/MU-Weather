# 30-second Android trace scoped to the MU Weather app's atrace sections.
buffers {
  size_kb: 65536
  fill_policy: RING_BUFFER
}
duration_ms: 30000
flush_period_ms: 2000

# CPU scheduling/frequency plus Android graphics/view/app trace sections. Device
# kernels differ; if an event is unavailable, capture a supported config and
# record the missing track rather than treating it as a zero measurement.
data_sources {
  config {
    name: "linux.ftrace"
    ftrace_config {
      ftrace_events: "sched/sched_switch"
      ftrace_events: "sched/sched_wakeup"
      ftrace_events: "power/cpu_frequency"
      ftrace_events: "power/cpu_idle"
      atrace_categories: "gfx"
      atrace_categories: "view"
      atrace_categories: "wm"
      atrace_categories: "am"
      atrace_categories: "input"
      atrace_categories: "dalvik"
      atrace_apps: "com.avithegod.muweather"
    }
  }
}

data_sources {
  config {
    name: "android.surfaceflinger.frametimeline"
  }
}

data_sources {
  config {
    name: "linux.process_stats"
    process_stats_config {
      scan_all_processes_on_start: true
    }
  }
}
