{
  "expo": {
    "name": "MU Weather",
    "slug": "mu-weather",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D1631",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.avithegod.muweather",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MU Weather uses your location to show local weather conditions."
        }
      ],
      "expo-sharing",
      [
        "expo-calendar",
        {
          "calendarPermission": "MU Weather shows the forecast for your upcoming events.",
          "calendarWritePermission": "MU Weather shows the forecast for your upcoming events."
        }
      ],
      "expo-background-task",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "MUWeatherWidget",
              "label": "MU Weather",
              "description": "Current temperature and conditions at a glance",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "MUWeatherWidgetLarge",
              "label": "MU Weather Large",
              "description": "Conditions with an hourly forecast strip",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "423a57f0-6df1-4b61-959e-2a7ed9513113"
      }
    },
    "owner": "avithegod-team"
  }
}
